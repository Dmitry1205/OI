;;1
(define-syntax trace
  (syntax-rules()
    ((trace xs)
     (let ((dop xs))
       (write 'xs)
       (display " => ")
       (write dop)
       (newline)
       dop))           
    )
  )
;;2
(define-syntax test
  (syntax-rules()
    ((test res etalon) '(res etalon))
    )
  )
(define (run-test xs)
  (write (car xs))
  (define func-res (eval (car xs) (interaction-environment)))
  (if(equal? func-res (cadr xs))
     (let ((res (equal? func-res (cadr xs))))
       (display " ok\n")
       res)
     (let ((res (equal? func-res (cadr xs))))
       (display " FAIL\n")
       (display "  Expected: ")
       (write (cadr xs))
       (newline)
       (display "  Returned: ")
       (write func-res)
       (newline)
       res)))
(define (run-tests tests)
  (if(null? (cdr tests))
     (run-test (car tests))
     ((lambda (x y)
        (and x y))
      (run-test (car tests))
      (run-tests (cdr tests))
      ))
  )
;;3
(define(reverse! . xss)
  ;;help-functions
  (define (list-set! a index new_el n)
    (if(null? a)
       '()
       (if(= n index)
          (set-car! a new_el)
          (list-set! (cdr a) index new_el (+ n 1)))))
  (define (type-length a)
    (cond
      ((string? a) (string-length a))
      ((vector? a) (vector-length a))
      ((list? a) (length a))
      )
    )
  (define (type-ref a index)
    (cond
      ((string? a) (string-ref a index))
      ((vector? a) (vector-ref a index))
      ((list? a) (list-ref a index))
      )
    )
  (define (type-set! a index new_el)
    (cond
      ((string? a)
       (string-set!  a index (if(integer? new_el)
                                (string-ref (number->string new_el) 0)
                                (if(symbol? new_el)
                                   (string-ref (symbol->string new_el) 0)
                                   new_el))))

      ((vector? a) (vector-set! a index new_el))
      ((list? a) (list-set! a index new_el 0))
      )
    )
  (define (type->list xs)
    (if(string? xs)
       (string->list xs)
       (if(vector? xs)
          (vector->list xs)
          xs)
       )
    )
  ;;main
  (if(= (length xss) 2)
     (let((xs (car xss)))
       (define receiver (cadr xss))
       (if(equal? xs receiver)
          (reverse! xs)
          (let()
            (define len (type-length xs))
            (do((i 0 (+ i 1)))
              ((<= len i))
              (let()
                (type-set! receiver i (type-ref xs (- len i 1)))))
            )
          )
       )
     (let((xs (car xss)))
       (let((len (type-length xs)))
         (do((i 0 (+ i 1)))
           ((<= (/ len 2) i))
           (let()
             (define dop (type-ref xs i))
             (type-set! xs i (type-ref xs (- len i 1)))
             (type-set! xs (- len i 1) dop)
             )
           ))
       )
     )
  )

