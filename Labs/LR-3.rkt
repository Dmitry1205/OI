(define (factorize xs)
  (define op (car xs))
  (define sl1 (cadr xs))
  (define sl2 (caddr xs))
  (define a (cadr (cadr xs)))
  (define b (cadr (caddr xs)))
  (if(and (equal? op '-) (equal? (caddr sl1) '2) (equal? (caddr sl2) '2))
     `(* (- ,a ,b) (+ ,a ,b))
     (if(and (equal? op '-) (equal? (caddr sl1) '3) (equal? (caddr sl2) '3))
         `(* (- ,a ,b) (+ (expt ,a 2) (* ,a ,b) (expt ,b 2)))
         `(* (+ ,a ,b) (+ (expt ,a 2) (- (* ,a ,b)) (expt ,b 2)))
     )
  )
  )
(define the-tests
  (list
   (test (factorize '(- (expt x 2) (expt y 2)))
         (* (- x y) (+ x y)))
   (test (factorize '(- (expt (+ first 1) 2) (expt (- second 1) 2)))
         (* (- (+ first 1) (- second 1)) (+ (+ first 1) (- second 1))))
   (test (eval (list (list 'lambda'(x y) (factorize '(- (expt x 2) 
                        (expt y 2)))) 1 2) (interaction-environment)) -3)
   (test (factorize '(- (expt x 3) (expt y 3)))
         (* (- x y) (+ (expt x 2) (* x y) (expt y 2))))
   (test (factorize '(- (expt (+ a b c) 2) (expt (- d e f) 2)))
         (* (- (+ a b c) (- d e f)) (+ (+ a b c) (- d e f))))
   (test (factorize '(+ (expt x 3) (expt y 3)))
         (* (+ x y) (+ (expt x 2) (- (* x y)) (expt y 2))))
   (test (eval (list (list 'lambda'(x y) (factorize '(+ (expt x 3) 
                        (expt y 3)))) 3 2) (interaction-environment)) 35)
   (test (eval (list (list 'lambda'(x y) (factorize '(- (expt x 3) 
                        (expt y 3)))) 5 4) (interaction-environment)) 61)
   ))
(run-tests the-tests)
