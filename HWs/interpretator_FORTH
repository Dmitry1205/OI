'feature-if-else
'feature-nested-if
'feature-while-loop
'feature-repeat-loop
'feature-for-loop
'feature-break-continue
'feature-switch-case
'feature-tail-call
'feature-global
(define (interpret program stack)
  (define len (vector-length program))
  (define (razbor i stack stv dict)
    (if(= i len)
       stack
       (let((el (vector-ref program i)))
         (cond
           ((number? el)
            (razbor (+ i 1) (cons el stack) stv dict))
           ((equal? el '+)
            (razbor (+ i 1) (cons (+ (cadr stack)
                                     (car stack))
                                  (cddr stack)) stv dict))
           ((equal? el '-)
            (razbor (+ i 1) (cons (- (cadr stack)
                                     (car stack))
                                  (cddr stack)) stv dict))
           ((equal? el '*)
            (razbor (+ i 1) (cons (* (cadr stack)
                                     (car stack))
                                  (cddr stack)) stv dict))
           ((equal? el '/)
            (razbor (+ i 1) (cons (quotient (cadr stack)
                                            (car stack))
                                  (cddr stack)) stv dict))
           ((equal? el 'mod)
            (razbor (+ i 1) (cons (remainder (cadr stack)
                                             (car stack))
                                  (cddr stack)) stv dict))
           ((equal? el 'neg)
            (razbor (+ i 1) (cons (- (car stack))
                                  (cdr stack)) stv dict))
           ((equal? el '=)
            (razbor (+ i 1) (cons (cond
                                    ((= (car stack) (cadr stack)) -1)
                                    (else 0)
                                    )
                                  (cddr stack)) stv dict))
           ((equal? el '>)
            (razbor (+ i 1) (cons (cond
                                    ((> (cadr stack) (car stack)) -1)
                                    (else 0)
                                    )
                                  (cddr stack)) stv dict))
           ((equal? el '<)
            (razbor (+ i 1) (cons (cond
                                    ((< (cadr stack) (car stack)) -1)
                                    (else 0)
                                    )
                                  (cddr stack)) stv dict))
           ((equal? el 'not)
            (razbor (+ i 1) (cons (cond
                                    ((= (car stack) 0) -1)
                                    (else 0)
                                    )
                                  (cdr stack)) stv dict))
           ((equal? el 'and)
            (razbor (+ i 1) (cons (cond
                                    ((or (= (cadr stack) 0)
                                         (= (car stack) 0)) 0)
                                    (else -1)
                                    )
                                  (cddr stack)) stv dict))
           ((equal? el 'or)
            (razbor (+ i 1) (cons (cond
                                    ((and (= (cadr stack) 0)
                                          (= (car stack) 0)) 0)
                                    (else -1)
                                    )
                                  (cddr stack)) stv dict))
           ((equal? el 'drop)
            (razbor (+ i 1) (cdr stack) stv dict))
           ((equal? el 'swap)
            (razbor (+ i 1) (append (list (cadr stack))
                                    (list (car stack))
                                    (cddr stack)) stv dict))
           ((equal? el 'dup)
            (razbor (+ i 1) (cons (car stack)
                                  stack) stv dict))
           ((equal? el 'over)
            (razbor (+ i 1) (cons (cadr stack)
                                  stack) stv dict))
           ((equal? el 'rot)
            (razbor (+ i 1) (append
                             (list (caddr stack))
                             (list (cadr stack))
                             (list (car stack))
                             (cdddr stack)) stv dict))
           ((equal? el 'depth)
            (razbor (+ i 1) (cons (length stack)
                                  stack) stv dict))
           ((equal? el 'define)
            (let((name-func (vector-ref program (+ i 1))))
              (define (skip-code j)
                (if(equal? (vector-ref program j) 'end)
                   (razbor (+ j 1) stack stv (cons (list name-func (+ i 2)) dict))
                   (skip-code (+ j 1))
                   )
                )
              (skip-code (+ i 2))
              )
            )
           ((equal? el 'endif)
            (razbor (+ i 1) stack stv dict)
            )
           ((equal? el 'else)
            (let()
              (define (skip-code j)
                (if(equal? (vector-ref program j) 'endif)
                   (razbor (+ j 1) stack stv dict)
                   (skip-code (+ j 1))
                   )
                )
              (skip-code (+ i 1))
              )
            )
           ((equal? el 'end)
            (razbor (car stv) stack (cdr stv) dict)
            )
           ((equal? el 'while)
            (if(= (car stack) 0)
               (let()
                 (define (skip-code j col-while)
                   (cond
                     ((equal? (vector-ref program j) 'wend)
                      (cond
                        ((= col-while 0) (razbor (+ j 1) (cdr stack) stv dict))
                        (else (skip-code (+ j 1) (- col-while 1)))
                      ))
                      ((equal? (vector-ref program j) 'while)
                       (skip-code (+ j 1) (+ col-while 1)))
                     (else (skip-code (+ j 1) col-while))
                     )
                   )
                 (skip-code (+ i 1) 0)
                 )
               (razbor (+ i 1) (cdr stack) (cons i stv) dict)
               )
            )
           ((equal? el 'wend)
            (razbor (car stv) stack (cdr stv) dict)
            )
           ((equal? el 'repeat)
            (razbor (+ i 1) stack (cons i stv) dict)
            )
           ((equal? el 'until)
            (if(not(= (car stack) 0))
               (razbor (+ i 1) (cdr stack) (cdr stv) dict)
               (razbor (car stv) (cdr stack) (cdr stv) dict)
               )
            )
           ((equal? el 'break)
            (let()
              (define (skip-code j)
                (cond
                  ((equal? (vector-ref program j) 'wend)
                   (razbor (+ j 1) stack (cdr stv) dict))
                  ((equal? (vector-ref program j) 'until)
                   (razbor (+ j 1) stack (cdr stv) dict))
                  ((equal? (vector-ref program j) 'next)
                   (razbor (+ j 1) stack (cdr stv) dict))
                  (else (skip-code (+ j 1)))
                  )
                )
              (skip-code (+ i 1))
              )
            )
           ((equal? el 'continue)
            (let()
              (define (skip-code j)
                (cond
                  ((equal? (vector-ref program j) 'wend)
                   (razbor j stack stv dict))
                  ((equal? (vector-ref program j) 'until)
                   (razbor j stack stv dict))
                  ((equal? (vector-ref program j) 'next)
                   (razbor j stack stv dict))
                  (else (skip-code (+ j 1)))
                  )
                )
              (skip-code (+ i 1))
              )
            )
           ((equal? el 'exit)
            (if(not(null? stv))
               (razbor (car stv) stack (cdr stv) dict)
               (razbor (+ i 1) stack (cdr stv) dict)
               )
            )
           ((equal? el 'switch)
            (let((metka (car stack)))
              (define (case-check j)
                (cond
                  ((and (equal? (vector-ref program j) 'case)
                        (= (vector-ref program (+ j 1)) metka))
                   (razbor (+ j 2) (cdr stack) stv dict))
                  ((equal? (vector-ref program j) 'endswitch)
                   (razbor (+ j 1) (cdr stack) stv dict))
                  (else (case-check (+ j 1)))
                  )
                )
              (case-check (+ i 1))
              )
            )
           ((equal? el 'exitcase)
            (let()
              (define (skip-code j)
                (cond
                  ((equal? (vector-ref program j) 'endswitch)
                   (razbor (+ j 1) stack stv dict))
                  (else (skip-code (+ j 1)))
                  )
                )
              (skip-code (+ i 1))
              )
            )
           ((equal? el 'endswitch)
            (razbor (+ i 1) stack stv dict))
           ((equal? el 'case)
            (razbor (+ i 2) stack stv dict)
            )
           ((equal? el 'tail)
            (let((name (vector-ref program (+ i 1))))
              (razbor (cadr (assoc name dict)) stack stv dict)
              )
            )
           ((equal? el 'if)
            (if(= (car stack) 0)
               (let()
                 (define (skip-code j col-if)
                   (cond
                     ((equal? (vector-ref program j) 'if)
                      (skip-code (+ j 1) (+ col-if 1)))
                     ((equal? (vector-ref program j) 'endif)
                      (cond
                        ((= col-if 0)(razbor (+ j 1) (cdr stack) stv dict))
                        (else (skip-code (+ j 1) (- col-if 1)))))
                     ((equal? (vector-ref program j) 'else)
                      (cond
                        ((= col-if 0) (razbor (+ j 1) (cdr stack) stv dict))
                        (else (skip-code (+ j 1) col-if)) 
                        ))
                     (else (skip-code (+ j 1) col-if))
                     )
                   )
                 (skip-code (+ i 1) 0)
                 )
               (razbor (+ i 1) (cdr stack) stv dict)
               )
            )
           ((equal? el 'defvar)
            (razbor (+ i 3) stack stv (cons (list
                                             (vector-ref program (+ i 1))
                                             'gl
                                             (vector-ref program (+ i 2))) dict))
            )
           ((equal? el 'set)
            (begin
              (set-car! (cddr (assoc (vector-ref program (+ i 1)) dict))
                        (car stack))
              (razbor (+ i 2) (cdr stack) stv dict)
              )
            )
           ((equal? el 'for)
            (razbor (+ i 1) (cddr stack) (cons (list (+ i 1) (cadr stack) (car stack)) stv) dict)
            )
           ((equal? el 'next)
            (cond
              ((>= (cadar stv) (caddar stv)) (razbor (+ i 1) stack (cdr stv) dict))
              (else (razbor (caar stv) stack (cons
                                              (list (caar stv)
                                                    (+ (cadar stv) 1)
                                                    (caddar stv)) (cdr stv)) dict))
              )
            )
           ((assoc el dict)
            (cond
              ((equal? (cadr (assoc el dict)) 'gl)
               (razbor (+ i 1) (cons (caddr (assoc el dict)) stack) stv dict))
              (else (razbor (cadr (assoc el dict)) stack (cons (+ i 1) stv) dict)
                    ))
            )
           ((equal? el 'i)
            (razbor (+ i 1) (cons (cadar stv) stack) stv dict)
            )
           )
         )
       )
    )
  (razbor 0 stack '() '())
  )
